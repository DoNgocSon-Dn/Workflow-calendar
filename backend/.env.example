PORT=3000
CORS_ORIGIN=http://localhost:4200
# Base URL public của backend — dùng để build link "Đồng ý/Từ chối" trong
# email mời. Khi deploy thật, đổi thành domain backend thật (VD Railway/Render).
API_BASE_URL=http://localhost:3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Bắt buộc cho reminder cron, task-deadline cron và endpoint respond-via-email
# (những chỗ không có JWT của user). Lấy ở Supabase Dashboard > Project
# Settings > API Keys > mục "Secret keys" (key bắt đầu bằng sb_secret_ — đây là
# tên gọi mới của service_role key; KHÔNG dùng key "Publishable").
# Thiếu biến này thì cron sẽ lỗi "supabaseKey is required" mỗi lần chạy.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# AI chatbot (Phase 1.4) — lấy key miễn phí tại Google AI Studio:
# https://aistudio.google.com/app/apikey
# AI Studio phát key ở 2 định dạng, cả hai đều dùng được: "AIzaSy..." (cũ) hoặc
# "AQ.Ab8..." (mới). Bấm "Create API key" và copy nguyên chuỗi.
GEMINI_API_KEY=

# Email mời + xác nhận trong mail + reminder email (Phase 1.4) — dùng Gmail +
# App Password (KHÔNG dùng mật khẩu Gmail thường):
# 1. Bật xác thực 2 bước cho tài khoản Gmail.
# 2. Tạo App Password tại https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Web Push — đẩy nhắc lịch tới máy người dùng KỂ CẢ khi đã đóng trình duyệt.
# Sinh cặp khoá 1 lần:  npx web-push generate-vapid-keys
# Public key phải trùng với `vapidPublicKey` trong frontend/src/environments/.
# Thiếu 2 biến này ⇒ push bị TẮT (vẫn còn email + popup khi app mở).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: liên hệ khi push service gặp sự cố. Bỏ trống ⇒ dùng mailto:GMAIL_USER.
VAPID_SUBJECT=

# Bảo vệ endpoint POST /system-notifications (gửi thông báo hệ thống tới toàn
# bộ hoặc một người dùng). Tự đặt một chuỗi bí mật bất kỳ; gọi API phải kèm
# header `x-system-token` khớp giá trị này.
# Để trống = endpoint bị TẮT hẳn (trả 503) — không ai broadcast được.
SYSTEM_NOTIFICATION_TOKEN=
